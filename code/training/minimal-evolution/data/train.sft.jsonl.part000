odeId\":\"n603\",\"op\":\"set_param\"}],\"executionEvidence\":{\"acceptance\":\"passed\",\"status\":\"completed\"},\"observations\":[{\"expected\":3,\"rows\":[{\"category\":0,\"id\":0,\"quality\":3,\"value\":-4},{\"category\":1,\"id\":1,\"quality\":2,\"value\":21},{\"category\":2,\"id\":2,\"quality\":7,\"value\":2},{\"category\":0,\"id\":3,\"quality\":7,\"value\":12},{\"category\":1,\"id\":4,\"quality\":-2,\"value\":2},{\"category\":2,\"id\":0,\"quality\":4,\"value\":19},{\"category\":0,\"id\":1,\"quality\":-1,\"value\":22},{\"category\":1,\"id\":2,\"quality\":5,\"value\":2},{\"category\":90,\"id\":90,\"quality\":4,\"value\":19},{\"category\":91,\"id\":91,\"quality\":5,\"value\":7},{\"category\":91,\"id\":91,\"quality\":6,\"value\":31}]},{\"expected\":5,\"rows\":[{\"category\":0,\"id\":0,\"quality\":7,\"value\":8},{\"category\":1,\"id\":1,\"quality\":-1,\"value\":23},{\"category\":2,\"id\":2,\"quality\":6,\"value\":17},{\"category\":0,\"id\":3,\"quality\":4,\"value\":13},{\"category\":1,\"id\":4,\"quality\":7,\"value\":9},{\"category\":2,\"id\":0,\"quality\":-1,\"value\":3},{\"category\":0,\"id\":1,\"quality\":2,\"value\":10},{\"category\":1,\"id\":2,\"quality\":-2,\"value\":1},{\"category\":2,\"id\":3,\"quality\":7,\"value\":24},{\"category\":90,\"id\":90,\"quality\":4,\"value\":19},{\"category\":91,\"id\":91,\"quality\":5,\"value\":7},{\"category\":91,\"id\":91,\"quality\":6,\"value\":31}]}],\"task\":{\"aggregate\":\"count\",\"dedupKey\":\"id\",\"factor\":6,\"minimum\":5,\"name\":\"实验数据汇总\",\"outputNodeId\":\"n126\"}}","split":"train"}
