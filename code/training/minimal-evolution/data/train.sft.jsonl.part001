odeId\":\"n592\",\"op\":\"set_param\"}],\"executionEvidence\":{\"acceptance\":\"passed\",\"status\":\"completed\"},\"observations\":[{\"expected\":2,\"rows\":[{\"category\":0,\"id\":0,\"quality\":5,\"value\":9},{\"category\":1,\"id\":1,\"quality\":3,\"value\":26},{\"category\":2,\"id\":2,\"quality\":0,\"value\":12},{\"category\":0,\"id\":3,\"quality\":1,\"value\":7},{\"category\":1,\"id\":4,\"quality\":0,\"value\":20},{\"category\":2,\"id\":0,\"quality\":3,\"value\":5},{\"category\":0,\"id\":1,\"quality\":4,\"value\":5},{\"category\":1,\"id\":2,\"quality\":0,\"value\":22},{\"category\":90,\"id\":90,\"quality\":4,\"value\":19},{\"category\":91,\"id\":91,\"quality\":5,\"value\":7},{\"category\":91,\"id\":91,\"quality\":6,\"value\":31}]},{\"expected\":4,\"rows\":[{\"category\":0,\"id\":0,\"quality\":8,\"value\":-5},{\"category\":1,\"id\":1,\"quality\":8,\"value\":29},{\"category\":2,\"id\":2,\"quality\":2,\"value\":0},{\"category\":0,\"id\":3,\"quality\":5,\"value\":20},{\"category\":1,\"id\":4,\"quality\":-2,\"value\":27},{\"category\":2,\"id\":0,\"quality\":-2,\"value\":8},{\"category\":0,\"id\":1,\"quality\":6,\"value\":3},{\"category\":1,\"id\":2,\"quality\":2,\"value\":-8},{\"category\":2,\"id\":3,\"quality\":5,\"value\":22},{\"category\":90,\"id\":90,\"quality\":4,\"value\":19},{\"category\":91,\"id\":91,\"quality\":5,\"value\":7},{\"category\":91,\"id\":91,\"quality\":6,\"value\":31}]}],\"task\":{\"aggregate\":\"count\",\"dedupKey\":\"id\",\"factor\":6,\"minimum\":5,\"name\":\"样本统计\",\"outputNodeId\":\"n570\"}}","split":"train"}
