DROP TABLE IF EXISTS `publisher`;
CREATE TABLE `publisher` (
	`id_fake` int NOT NULL AUTO_INCREMENT,
	`id` int DEFAULT NULL,
	`publisher_name` text DEFAULT NULL,
	PRIMARY KEY (`id_fake`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

