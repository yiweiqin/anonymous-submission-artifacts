odeId\":\"n157\",\"op\":\"set_param\"}],\"executionEvidence\":{\"acceptance\":\"passed\",\"status\":\"completed\"},\"observations\":[{\"expected\":5,\"rows\":[{\"category\":0,\"id\":0,\"quality\":3,\"value\":19},{\"category\":1,\"id\":1,\"quality\":5,\"value\":24},{\"category\":2,\"id\":2,\"quality\":8,\"value\":-1},{\"category\":0,\"id\":3,\"quality\":8,\"value\":-2},{\"category\":1,\"id\":4,\"quality\":5,\"value\":2},{\"category\":2,\"id\":0,\"quality\":2,\"value\":23},{\"category\":0,\"id\":1,\"quality\":1,\"value\":26},{\"category\":1,\"id\":2,\"quality\":3,\"value\":6},{\"category\":90,\"id\":90,\"quality\":4,\"value\":19},{\"category\":91,\"id\":91,\"quality\":5,\"value\":7},{\"category\":91,\"id\":91,\"quality\":6,\"value\":31}]},{\"expected\":3,\"rows\":[{\"category\":0,\"id\":0,\"quality\":8,\"value\":6},{\"category\":1,\"id\":1,\"quality\":5,\"value\":10},{\"category\":2,\"id\":2,\"quality\":1,\"value\":9},{\"category\":0,\"id\":3,\"quality\":2,\"value\":4},{\"category\":1,\"id\":4,\"quality\":0,\"value\":15},{\"category\":2,\"id\":0,\"quality\":2,\"value\":9},{\"category\":0,\"id\":1,\"quality\":1,\"value\":11},{\"category\":1,\"id\":2,\"quality\":4,\"value\":26},{\"category\":2,\"id\":3,\"quality\":2,\"value\":13},{\"category\":90,\"id\":90,\"quality\":4,\"value\":19},{\"category\":91,\"id\":91,\"quality\":5,\"value\":7},{\"category\":91,\"id\":91,\"quality\":6,\"value\":31}]}],\"task\":{\"aggregate\":\"count\",\"dedupKey\":\"id\",\"factor\":3,\"minimum\":5,\"name\":\"实验数据汇总\",\"outputNodeId\":\"n327\"}}","split":"train"}
