odeId\":\"n920\",\"op\":\"set_param\"}],\"executionEvidence\":{\"acceptance\":\"passed\",\"status\":\"completed\"},\"observations\":[{\"expected\":6,\"rows\":[{\"category\":0,\"id\":0,\"quality\":5,\"value\":21},{\"category\":1,\"id\":1,\"quality\":-2,\"value\":-2},{\"category\":2,\"id\":2,\"quality\":3,\"value\":17},{\"category\":0,\"id\":3,\"quality\":7,\"value\":17},{\"category\":1,\"id\":4,\"quality\":5,\"value\":24},{\"category\":2,\"id\":0,\"quality\":7,\"value\":5},{\"category\":0,\"id\":1,\"quality\":5,\"value\":19},{\"category\":1,\"id\":2,\"quality\":-1,\"value\":-6},{\"category\":90,\"id\":90,\"quality\":2,\"value\":19},{\"category\":91,\"id\":91,\"quality\":3,\"value\":7},{\"category\":91,\"id\":91,\"quality\":4,\"value\":31}]},{\"expected\":5,\"rows\":[{\"category\":0,\"id\":0,\"quality\":3,\"value\":10},{\"category\":1,\"id\":1,\"quality\":6,\"value\":13},{\"category\":2,\"id\":2,\"quality\":0,\"value\":0},{\"category\":0,\"id\":3,\"quality\":0,\"value\":12},{\"category\":1,\"id\":4,\"quality\":8,\"value\":11},{\"category\":2,\"id\":0,\"quality\":-1,\"value\":18},{\"category\":0,\"id\":1,\"quality\":6,\"value\":23},{\"category\":1,\"id\":2,\"quality\":7,\"value\":7},{\"category\":2,\"id\":3,\"quality\":0,\"value\":11},{\"category\":90,\"id\":90,\"quality\":2,\"value\":19},{\"category\":91,\"id\":91,\"quality\":3,\"value\":7},{\"category\":91,\"id\":91,\"quality\":4,\"value\":31}]}],\"task\":{\"aggregate\":\"count\",\"dedupKey\":\"id\",\"factor\":6,\"minimum\":3,\"name\":\"实验数据汇总\",\"outputNodeId\":\"n604\"}}","split":"train"}
